# Application
APP_NAME=runtime-incident-platform
APP_PORT=8080
SHUTDOWN_TIMEOUT=10s
CLUSTER_ID=local-dev
TENANT_ID=default
KUBERNETES_ENABLED=false
HTTP_REQUEST_TIMEOUT=15s
HTTP_MAX_BODY_BYTES=1048576

# PostgreSQL (example credentials only; replace outside source control)
POSTGRES_DSN=postgres://runtime:change-me@127.0.0.1:5432/runtime_incidents?sslmode=disable
POSTGRES_TIMEOUT=5s

# Data sources and cache
REDIS_ADDR=127.0.0.1:6379
PROMETHEUS_URL=http://127.0.0.1:9090
LOKI_URL=http://127.0.0.1:3100
TEMPO_URL=http://127.0.0.1:3200

# Workers
WEBHOOK_WORKERS=2
# Leave WEBHOOK_URL empty to disable delivery. Inject WEBHOOK_SECRET from the environment or a Kubernetes Secret.
WEBHOOK_TARGET_NAME=incident-agent
WEBHOOK_URL=
WEBHOOK_SECRET=
# Explicit comma-separated hostnames/CIDRs for authorized cluster-internal targets.
WEBHOOK_ALLOWLIST=
WEBHOOK_CONNECT_TIMEOUT=3s
WEBHOOK_REQUEST_TIMEOUT=10s
WEBHOOK_POLL_INTERVAL=1s
WEBHOOK_RETRY_BASE=1s
WEBHOOK_RETRY_MAX=1m
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BATCH_SIZE=20
SIGNAL_WORKERS=2
SIGNAL_MAX_RETRIES=5
SIGNAL_RETRY_BASE=100ms
SIGNAL_RETRY_MAX=30s

# Resource graph retention and bounded cleanup
RESOURCE_GRAPH_RETENTION=168h
RESOURCE_GRAPH_CLEANUP_INTERVAL=1h
RESOURCE_GRAPH_CLEANUP_TIMEOUT=5s
RESOURCE_GRAPH_CLEANUP_BATCH=100
